+QVector<TouchReportStep> buildTouchReportSteps(QVector<ActiveTouchPointer>& active,
+                                               const QVector<TouchPointer>& changed, int action) {
+  using aap_protobuf::service::inputsource::message::PointerAction;
+  QVector<TouchReportStep> steps;
+
+  auto indexOf = [&active](int id) {
+    for (int i = 0; i < active.size(); ++i) {
+      if (active[i].point.id == id) return i;
+    }
+    return -1;
+  };
+  auto freeSlot = [&active]() {
+    for (int slot = 0;; ++slot) {
+      bool used = false;
+      for (const auto& a : active) used = used || a.slot == slot;
+      if (!used) return slot;
+    }
+  };
+
+  if (action == 0) {
+    for (const TouchPointer& p : changed) {
+      const int stale = indexOf(p.id);  // a lost release left this id behind
+      if (stale >= 0) active.remove(stale);
+      active.append({p, freeSlot()});
+      steps.append({active.size() == 1 ? PointerAction::ACTION_DOWN
+                                       : PointerAction::ACTION_POINTER_DOWN,
+                    static_cast<int>(active.size()) - 1, active});
+    }
+  } else if (action == 1) {
+    for (const TouchPointer& p : changed) {
+      const int idx = indexOf(p.id);
+      if (idx < 0) continue;
+      active[idx].point = p;
+      steps.append({active.size() == 1 ? PointerAction::ACTION_UP
+                                       : PointerAction::ACTION_POINTER_UP,
+                    idx, active});
+      active.remove(idx);
+    }
+  } else {
+    bool moved = false;
+    for (const TouchPointer& p : changed) {
+      const int idx = indexOf(p.id);
+      if (idx < 0) continue;
+      active[idx].point = p;
+      moved = true;
+    }
+    if (moved) steps.append({PointerAction::ACTION_MOVED, 0, active});
+  }
+  return steps;
+}
+
+aap_protobuf::service::inputsource::message::InputReport createMultiTouchInputReport(
+    const TouchReportStep& step, uint64_t timestamp) {
+  aap_protobuf::service::inputsource::message::InputReport inputReport;
+  inputReport.set_timestamp(timestamp == 0 ? getCurrentTimestampMicros() : timestamp);
+
+  auto* touchEvent = inputReport.mutable_touch_event();
+  for (const ActiveTouchPointer& a : step.pointers) {
+    auto* pointerData = touchEvent->add_pointer_data();
+    pointerData->set_x(static_cast<uint32_t>(a.point.x));
+    pointerData->set_y(static_cast<uint32_t>(a.point.y));
+    pointerData->set_pointer_id(static_cast<uint32_t>(a.slot));
+  }
+  touchEvent->set_action(step.action);
+  touchEvent->set_action_index(static_cast<uint32_t>(step.actionIndex));
+  return inputReport;
+}
