+bool RealAndroidAutoService::sendMultiTouchInput(const QVector<TouchPointer>& points, int action) {
+  if (!isConnected() || !m_inputChannel) {
+    m_activePointers.clear();  // a new session must not inherit fingers from the old one
+    Logger::instance().warning("Cannot send touch input: not connected or input channel disabled");
+    return false;
+  }
+
+  try {
+    using namespace crankshaft::protocol;
+
+    // Same coordinate space as sendTouchInput (advertised INPUT_SOURCE resolution).
+    QVector<TouchPointer> bounded = points;
+    for (TouchPointer& p : bounded) {
+      p.x = qBound(0, p.x, qMax(0, m_resolution.width() - 1));
+      p.y = qBound(0, p.y, qMax(0, m_resolution.height() - 1));
+    }
+
+    const auto steps = buildTouchReportSteps(m_activePointers, bounded, action);
+    for (const TouchReportStep& step : steps) {
+      auto data = createMultiTouchInputReport(step);
+      const quint64 reportNumber = ++m_touchInputCount;
+      Logger::instance().debug(QString("[AA][touch] multi report #%1 action=%2 index=%3 pointers=%4")
+                                   .arg(reportNumber)
+                                   .arg(static_cast<int>(step.action))
+                                   .arg(step.actionIndex)
+                                   .arg(step.pointers.size()));
+
+      auto promise = aasdk::channel::SendPromise::defer(*m_strand);
+      promise->then(
+          []() {},
+          [self = QPointer<RealAndroidAutoService>(this), reportNumber](
+              const aasdk::error::Error& error) {
+            const QString errorText = QString::fromStdString(error.what());
+            Logger::instance().warning(
+                QString("[AA][touch] multi report #%1 send FAILED: %2").arg(reportNumber).arg(errorText));
+            if (self &&
+                (isSslWrapperNoDeviceErrorText(errorText) ||
+                 isTransportNoDeviceErrorText(errorText) ||
+                 isUsbTransferNoDeviceErrorText(errorText))) {
+              self->onChannelError(QStringLiteral("input"), errorText);
+            }
+          });
+      m_inputChannel->sendInputReport(data, std::move(promise));
+    }
+    return true;
+  } catch (const std::exception& e) {
+    Logger::instance().error(QString("Failed to send multi-touch input: %1").arg(e.what()));
+    return false;
+  }
+}
