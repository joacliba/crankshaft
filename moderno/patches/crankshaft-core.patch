+// Multi-touch (pinch-zoom): the fingers that change in each UI event must become
+// Android-style reports carrying every finger on screen.
+
+#include <gtest/gtest.h>
+
+#include "../services/android_auto/ProtocolHelpers.h"
+
+using namespace crankshaft::protocol;
+using aap_protobuf::service::inputsource::message::PointerAction;
+
+TEST(TouchReportSteps, PinchSequence) {
+  QVector<ActiveTouchPointer> active;
+
+  // First finger (Qt ids can be huge) -> DOWN, slot 0.
+  auto s = buildTouchReportSteps(active, {{16777217, 100, 100}}, 0);
+  ASSERT_EQ(s.size(), 1);
+  EXPECT_EQ(s[0].action, PointerAction::ACTION_DOWN);
+  EXPECT_EQ(s[0].pointers.size(), 1);
+  EXPECT_EQ(s[0].pointers[0].slot, 0);
+
+  // Second finger -> POINTER_DOWN at index 1, both fingers in the report.
+  s = buildTouchReportSteps(active, {{16777218, 300, 300}}, 0);
+  ASSERT_EQ(s.size(), 1);
+  EXPECT_EQ(s[0].action, PointerAction::ACTION_POINTER_DOWN);
+  EXPECT_EQ(s[0].actionIndex, 1);
+  EXPECT_EQ(s[0].pointers.size(), 2);
+  EXPECT_EQ(s[0].pointers[1].slot, 1);
+
+  // Only one finger reported as moved -> one MOVE with both, the other keeps its position.
+  s = buildTouchReportSteps(active, {{16777218, 350, 350}}, 2);
+  ASSERT_EQ(s.size(), 1);
+  EXPECT_EQ(s[0].action, PointerAction::ACTION_MOVED);
+  EXPECT_EQ(s[0].pointers[0].point.x, 100);
+  EXPECT_EQ(s[0].pointers[1].point.x, 350);
+
+  // First finger lifts -> POINTER_UP at index 0; second keeps slot 1.
+  s = buildTouchReportSteps(active, {{16777217, 100, 100}}, 1);
+  ASSERT_EQ(s.size(), 1);
+  EXPECT_EQ(s[0].action, PointerAction::ACTION_POINTER_UP);
+  EXPECT_EQ(s[0].actionIndex, 0);
+  ASSERT_EQ(active.size(), 1);
+  EXPECT_EQ(active[0].slot, 1);
+
+  // Last finger lifts -> UP, nothing left.
+  s = buildTouchReportSteps(active, {{16777218, 350, 350}}, 1);
+  ASSERT_EQ(s.size(), 1);
+  EXPECT_EQ(s[0].action, PointerAction::ACTION_UP);
+  EXPECT_TRUE(active.isEmpty());
+
+  // Protobuf report carries slots as pointer ids and the action index.
+  QVector<ActiveTouchPointer> two;
+  buildTouchReportSteps(two, {{7, 1, 2}}, 0);
+  const auto step = buildTouchReportSteps(two, {{9, 3, 4}}, 0).first();
+  const auto report = createMultiTouchInputReport(step, 1);
+  ASSERT_EQ(report.touch_event().pointer_data_size(), 2);
+  EXPECT_EQ(report.touch_event().pointer_data(1).pointer_id(), 1u);
+  EXPECT_EQ(report.touch_event().action_index(), 1u);
+}
+
+TEST(TouchReportSteps, IgnoresUnknownFingersAndStaleIds) {
+  QVector<ActiveTouchPointer> active;
+  EXPECT_TRUE(buildTouchReportSteps(active, {{5, 0, 0}}, 1).isEmpty());  // up without down
+  EXPECT_TRUE(buildTouchReportSteps(active, {{5, 0, 0}}, 2).isEmpty());  // move without down
+
+  buildTouchReportSteps(active, {{5, 0, 0}}, 0);
+  const auto s = buildTouchReportSteps(active, {{5, 10, 10}}, 0);  // lost release, same id again
+  ASSERT_EQ(s.size(), 1);
+  EXPECT_EQ(s[0].action, PointerAction::ACTION_DOWN);
+  EXPECT_EQ(active.size(), 1);
+}
