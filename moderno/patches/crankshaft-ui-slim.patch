@@ -408,10 +408,22 @@ auto CoreClient::sendTouchEvent(const QString& eventType, const QVariantList& po
     const int pointerId = firstPoint.value("id", 0).toInt();
     const double pressure = firstPoint.value("pressure", 1.0).toDouble();
 
+    // Every changed finger goes in "points" (multi-touch: pinch-zoom); x/y stay for older cores.
+    QJsonArray pointArray;
+    for (const QVariant& point : points) {
+        const QVariantMap map = point.toMap();
+        QJsonObject p;
+        p["id"] = map.value("id", 0).toInt();
+        p["x"] = map.value("x").toDouble();
+        p["y"] = map.value("y").toDouble();
+        pointArray.append(p);
+    }
+
     QJsonObject touchPayload;
     touchPayload["x"] = x;
     touchPayload["y"] = y;
     touchPayload["action"] = eventType;
+    touchPayload["points"] = pointArray;
 
     QJsonObject touchMessage;
     touchMessage["type"] = "publish";
