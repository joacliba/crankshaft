+// Moderno: the Pi has no clock battery. If the phone's ping timestamps are wall-clock time, set the
+// clock from them. Two pings must agree on the unit, so an uptime counter is never taken for a date.
+void syncClockFromPhone(int64_t timestamp)
+{
+    static int64_t lastStamp = 0;
+    static std::chrono::steady_clock::time_point lastSeen;
+    static bool done = false;
+
+    const auto now = std::chrono::steady_clock::now();
+    if(done)
+    {
+        return;
+    }
+
+    if(lastStamp != 0)
+    {
+        const double localSecs = std::chrono::duration<double>(now - lastSeen).count();
+        for(const double unit : {1e9, 1e6, 1e3})
+        {
+            const double phoneSecs = static_cast<double>(timestamp - lastStamp) / unit;
+            const double epoch = static_cast<double>(timestamp) / unit;
+            if(localSecs >= 2 && std::fabs(phoneSecs - localSecs) < 0.2 * localSecs
+               && epoch > 1735689600.0 && epoch < 2208988800.0)  // 2025..2040
+            {
+                const long long secs = static_cast<long long>(epoch);
+                OPENAUTO_LOG(info) << "[AndroidAutoEntity] phone clock: " << secs << " (unit " << unit << ")";
+                if(std::llabs(secs - static_cast<long long>(std::time(nullptr))) > 60)
+                {
+                    std::system(("sudo date -u -s @" + std::to_string(secs) + " > /dev/null").c_str());
+                }
+                std::ofstream("/tmp/clock_synced") << secs << std::endl;
+                done = true;
+                break;
+            }
+        }
+    }
+
+    lastStamp = timestamp;
+    lastSeen = now;
+}
+
+}
 
