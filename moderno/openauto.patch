+TouchPointer InputDevice::toPointer(const QTouchEvent::TouchPoint& point)
+{
+    const uint32_t x = (static_cast<float>(point.pos().x()) / touchscreenGeometry_.width()) * displayGeometry_.width();
+    const uint32_t y = (static_cast<float>(point.pos().y()) / touchscreenGeometry_.height()) * displayGeometry_.height();
+    return {x, y, touchSlots_[point.id()]};
+}
+
+// Real multi-touch (pinch-zoom). Android expects every report to list all fingers on screen,
+// with PRESS/RELEASE for the first/last finger and POINTER_DOWN/UP for the others.
+bool InputDevice::handleTouchscreenEvent(QTouchEvent* touch)
+{
+    touch->accept();  // handled here: Qt must not also synthesize mouse events for it
+    if(!configuration_->getTouchscreenEnabled())
+    {
+        return true;
+    }
+
+    const bool cancel = touch->type() == QEvent::TouchCancel;
+    std::vector<QTouchEvent::TouchPoint> active;  // fingers already down before this event
+    for(const auto& point : touch->touchPoints())
+    {
+        if(point.state() != Qt::TouchPointPressed && touchSlots_.count(point.id()) > 0)
+        {
+            active.push_back(point);
+        }
+    }
+
+    auto send = [this, &active](aasdk::proto::enums::TouchAction::Enum type, size_t index) {
+        TouchEvent event{type, 0, 0, 0};
+        for(const auto& point : active)
+        {
+            event.pointers.push_back(this->toPointer(point));
+        }
+        event.x = event.pointers[index].x;
+        event.y = event.pointers[index].y;
+        event.pointerId = event.pointers[index].id;
+        event.actionIndex = static_cast<uint32_t>(index);
+        eventHandler_->onTouchEvent(event);
+    };
+
+    bool moved = false;
+    for(const auto& point : touch->touchPoints())
+    {
+        if(point.state() == Qt::TouchPointPressed && !cancel)
+        {
+            uint32_t slot = 0;
+            while(std::any_of(touchSlots_.begin(), touchSlots_.end(), [slot](const auto& entry) { return entry.second == slot; }))
+            {
+                ++slot;
+            }
+            touchSlots_[point.id()] = slot;
+            active.push_back(point);
+            send(active.size() == 1 ? aasdk::proto::enums::TouchAction::PRESS
+                                    : aasdk::proto::enums::TouchAction::POINTER_DOWN, active.size() - 1);
+        }
+        moved = moved || point.state() == Qt::TouchPointMoved;
+    }
+
+    if(moved && !active.empty())
+    {
+        send(aasdk::proto::enums::TouchAction::DRAG, 0);
+    }
+
+    for(size_t i = 0; i < active.size();)
+    {
+        if(cancel || active[i].state() == Qt::TouchPointReleased)
+        {
+            send(active.size() == 1 ? aasdk::proto::enums::TouchAction::RELEASE
+                                    : aasdk::proto::enums::TouchAction::POINTER_UP, i);
+            touchSlots_.erase(active[i].id());
+            active.erase(active.begin() + i);
+        }
+        else
+        {
+            ++i;
+        }
+    }
+
+    return true;
+}
