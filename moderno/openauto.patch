+// Sun elevation in degrees (NOAA low-precision formula, good to a few minutes of sunset time).
+double SensorService::sunElevation(double unixTime, double latitude, double longitude)
+{
+    const double rad = 3.14159265358979323846 / 180.0;
+    const double d = unixTime / 86400.0 + 2440587.5 - 2451545.0;  // days since J2000
+    const double g = std::fmod(357.529 + 0.98560028 * d, 360.0) * rad;
+    const double q = std::fmod(280.459 + 0.98564736 * d, 360.0);
+    const double l = std::fmod(q + 1.915 * std::sin(g) + 0.020 * std::sin(2 * g), 360.0) * rad;
+    const double e = (23.439 - 0.00000036 * d) * rad;
+    const double ra = std::atan2(std::cos(e) * std::sin(l), std::cos(l));
+    const double dec = std::asin(std::sin(e) * std::sin(l));
+    const double gmst = std::fmod(18.697374558 + 24.06570982441908 * d, 24.0);
+    const double ha = (gmst * 15.0 + longitude) * rad - ra;
+    const double lat = latitude * rad;
+    return std::asin(std::sin(lat) * std::sin(dec) + std::cos(lat) * std::cos(dec) * std::cos(ha)) / rad;
+}
+
+// Moderno: night when the sun is down, using the clock taken from the phone (or from the network).
+// With an untrusted clock it stays day. /boot/crankshaft/car_daynight restores Crankshaft's own
+// schedule/sensor; /boot/crankshaft/location ("lat lon") overrides the default (Madrid).
+bool SensorService::computeNight()
+{
+    if(is_file_exist("/boot/crankshaft/car_daynight"))
+    {
+        return is_file_exist("/tmp/night_mode_enabled");
+    }
+    if(!is_file_exist("/tmp/clock_synced") && !is_file_exist("/run/systemd/timesync/synchronized"))
+    {
+        return false;
+    }
+    double latitude = 40.42, longitude = -3.70;
+    double lat = 0, lon = 0;
+    if(std::ifstream("/boot/crankshaft/location") >> lat >> lon)
